{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Torrenta",
  "version": "1.3.0",
  "identifier": "com.torrenta.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Torrenta",
        "width": 1240,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true,
        "decorations": true,
        "visible": false,
        "theme": null,
        "backgroundColor": "#0F1319"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "publisher": "Torrenta",
    "shortDescription": "Лёгкий торрент-клиент на Rust",
    "longDescription": "Torrenta — быстрый и лёгкий торрент-клиент на Rust + Tauri 2: загрузка .torrent и magnet-ссылок, HTTP/UDP трекеры, статистика в реальном времени.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["ru-RU", "en-US"]
      }
    }
  }
}
